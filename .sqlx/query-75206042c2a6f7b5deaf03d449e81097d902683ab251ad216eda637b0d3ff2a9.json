  "query": "\n        SELECT\n            u.id,\n            u.first_name,\n            u.last_name,\n            u.email,\n            u.password,\n            u.roles as \"roles: Json<HashSet<Roles>>\",\n            u.created_at,\n            u.updated_at,\n            q.test_index\n        FROM exam_queue q\n        JOIN users u ON q.user_id = u.id\n        ORDER BY q.inserted_at\n        ",
